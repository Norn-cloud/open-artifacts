{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "norn-open-artifacts",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "artifacts.norn.cloud",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/mcp", "/api/*", "/a/*", "/og/*", "/fonts/*", "/vendor/*"]
  },
  "vars": {},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "norn-open-artifacts",
      "database_id": "52a58d7d-149c-469f-9895-83b8d867458c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "norn-open-artifacts-content"
    }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": true },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  "observability": { "enabled": true }
}
